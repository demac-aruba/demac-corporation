{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/scheduling-history-attribution-cards": false,
      "feature/property-dwellings-preview": false
    }
  },
  "framework": null,
  "ignoreCommand": "git log -1 --format=%B | grep -Fq '[merge-only]'",
  "installCommand": "npm install --prefix apps/erp-next --no-audit --no-fund",
  "buildCommand": "npm --prefix apps/erp-next run typecheck && npm --prefix apps/erp-next run build",
  "outputDirectory": "apps/erp-next/out",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
