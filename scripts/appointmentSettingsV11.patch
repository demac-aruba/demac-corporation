+// APPOINTMENT_SETTINGS_V11: office appointment presets are editable by administrators.
+export interface AppointmentWorkPreset {
+  id: string;
+  label: string;
+  durationMinutesPerUnit: number;
+  kind: 'service' | 'installation';
+  active: boolean;
+  sortOrder: number;
+}
+
+type AppointmentWorkPresetSettings = {
+  id: 'appointment-work-presets';
+  presets: AppointmentWorkPreset[];
+  updatedAt?: string;
+};
+
 const SYNC_INTERVAL_MS = 30_000;
 const DEFAULT_SETTINGS: BusinessCalendarSettings = { id: 'business-calendar', closedWeekdays: [0] };
+const APPOINTMENT_PRESETS_SETTINGS_ID = 'appointment-work-presets';
+export const DEFAULT_APPOINTMENT_WORK_PRESETS: AppointmentWorkPreset[] = [
+  { id: 'standard_service', label: 'Servicio estándar', durationMinutesPerUnit: 60, kind: 'service', active: true, sortOrder: 10 },
+  { id: 'deep_cleaning', label: 'Servicio deep cleaning', durationMinutesPerUnit: 120, kind: 'service', active: true, sortOrder: 20 },
+  { id: 'standard_installation', label: 'Instalación estándar', durationMinutesPerUnit: 120, kind: 'installation', active: true, sortOrder: 30 },
+  { id: 'special_installation', label: 'Instalación especial', durationMinutesPerUnit: 180, kind: 'installation', active: true, sortOrder: 40 },
+];
+
+export function formatAppointmentDuration(minutes: number) {
+  const safeMinutes = Math.max(30, Math.round(minutes / 30) * 30);
+  const hours = Math.floor(safeMinutes / 60);
+  const remainder = safeMinutes % 60;
+  if (!hours) return `${remainder} min`;
+  if (!remainder) return `${hours} hora${hours === 1 ? '' : 's'}`;
+  return `${hours} h ${remainder} min`;
+}
+
+function normalizeAppointmentWorkPresets(presets?: AppointmentWorkPreset[]) {
+  const source = Array.isArray(presets) && presets.length ? presets : DEFAULT_APPOINTMENT_WORK_PRESETS;
+  return source
+    .filter((preset) => preset && preset.id && preset.label)
+    .map((preset, index) => ({
+      id: String(preset.id),
+      label: String(preset.label).trim(),
+      durationMinutesPerUnit: Math.min(360, Math.max(30, Math.round(Number(preset.durationMinutesPerUnit || 60) / 30) * 30)),
+      kind: preset.kind === 'installation' ? 'installation' as const : 'service' as const,
+      active: preset.active !== false,
+      sortOrder: Number.isFinite(Number(preset.sortOrder)) ? Number(preset.sortOrder) : (index + 1) * 10,
+    }))
+    .sort((a, b) => a.sortOrder - b.sortOrder || a.label.localeCompare(b.label));
+}
 
