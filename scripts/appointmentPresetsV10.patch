+// APPOINTMENT_PRESETS_V10: standardized office scheduling keeps customer copy and technician-only instructions separate.
+type AppointmentWorkPreset = {
+  id: Exclude<AppointmentWorkType, 'other'>;
+  label: string;
+  hoursPerUnit: number;
+  kind: 'service' | 'installation';
+};
+
+const MAX_BOOKABLE_HOURS = 6;
+const appointmentWorkPresets: AppointmentWorkPreset[] = [
+  { id: 'standard_service', label: 'Servicio estándar', hoursPerUnit: 1, kind: 'service' },
+  { id: 'deep_cleaning', label: 'Servicio deep cleaning', hoursPerUnit: 2, kind: 'service' },
+  { id: 'standard_installation', label: 'Instalación estándar', hoursPerUnit: 2, kind: 'installation' },
+  { id: 'extended_installation', label: 'Instalación extendida', hoursPerUnit: 3, kind: 'installation' },
+  { id: 'rooftop_installation', label: 'Instalación en rooftop', hoursPerUnit: 3, kind: 'installation' },
+  { id: 'second_floor_installation', label: 'Instalación en segundo piso', hoursPerUnit: 3, kind: 'installation' },
+  { id: 'third_floor_installation', label: 'Instalación en tercer piso', hoursPerUnit: 3, kind: 'installation' },
+];
+
+function appointmentPreset(type?: AppointmentWorkType) {
+  return appointmentWorkPresets.find((preset) => preset.id === type);
+}
+
+function appointmentDescription(preset: AppointmentWorkPreset, count: number) {
+  const equipment = count === 1 ? '1 aire acondicionado' : `${count} aires acondicionados`;
+  return preset.kind === 'installation'
+    ? `${preset.label} de ${equipment}.`
+    : `${preset.label} para ${equipment}.`;
+}
+
+function maximumUnitsForPreset(preset: AppointmentWorkPreset) {
+  return Math.max(1, Math.floor(MAX_BOOKABLE_HOURS / preset.hoursPerUnit));
+}
