+function templateValueExists(value: unknown) {
+  if (value === null || value === undefined) return false;
+  if (typeof value === 'string') return value.trim().length > 0;
+  if (Array.isArray(value)) return value.length > 0;
+  return true;
+}
+
+export function templateMissingRequiredFieldKeys(definition: TemplateSectionDefinition, fields: Record<string, unknown>) {
+  const visibleFields = definition.fields.filter((field) => templateFieldIsVisible(field, fields));
+  const missing = visibleFields
+    .filter((field) => templateFieldIsRequired(field, fields) && !templateValueExists(fields[field.key]))
+    .map((field) => field.key);
+  const groups = Array.from(new Set(visibleFields.map((field) => field.requiredAlternativeGroup).filter((group): group is string => Boolean(group))));
+  groups.forEach((group) => {
+    const alternatives = visibleFields.filter((field) => field.requiredAlternativeGroup === group);
+    if (!alternatives.some((field) => templateValueExists(fields[field.key]))) missing.push(alternatives[0].key);
+  });
+  return missing;
+}
+
+export function templateRequiredProgress(definition: TemplateSectionDefinition, fields: Record<string, unknown>) {
+  const visibleFields = definition.fields.filter((field) => templateFieldIsVisible(field, fields));
+  const requiredFields = visibleFields.filter((field) => templateFieldIsRequired(field, fields));
+  const groups = Array.from(new Set(visibleFields.map((field) => field.requiredAlternativeGroup).filter((group): group is string => Boolean(group))));
+  return {
+    requiredCount: requiredFields.length + groups.length,
+    completedCount: requiredFields.filter((field) => templateValueExists(fields[field.key])).length
+      + groups.filter((group) => visibleFields.some((field) => field.requiredAlternativeGroup === group && templateValueExists(fields[field.key]))).length,
+  };
+}
