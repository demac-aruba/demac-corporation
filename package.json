{
  "name": "demac-corporation",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.4",
    "expo-image-picker": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "libphonenumber-js": "^1.13.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "~0.21.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "patch:payroll": "node scripts/patchPayrollStartDateStage1.cjs && node scripts/patchPayrollStartDateStage2.cjs && node scripts/patchPayrollOvertimeMinutes.cjs",
    "patch:technician-equipment": "node scripts/patchTechnicianEquipmentRealTesting.cjs",
    "patch:technician-interventions": "node scripts/patchTechnicianEquipmentInterventions.cjs",
    "patch:technician-reports": "node scripts/patchTechnicianReportSections.cjs",
    "patch:office-review": "node scripts/patchOfficeReportReview.cjs",
    "patch:report-output": "node scripts/patchReportOutput.cjs",
    "patch:customer-report": "node scripts/patchCustomerReportExperience.cjs",
    "patch:all": "npm run patch:payroll && npm run patch:technician-equipment && npm run patch:technician-interventions && npm run patch:technician-reports && npm run patch:office-review && npm run patch:report-output && npm run patch:customer-report",
    "prestart": "npm run patch:all",
    "start": "expo start",
    "preandroid": "npm run patch:all",
    "android": "expo start --android",
    "preios": "npm run patch:all",
    "ios": "expo start --ios",
    "preweb": "npm run patch:all",
    "web": "expo start --web",
    "pretypecheck": "npm run patch:all",
    "typecheck": "tsc --noEmit",
    "prebuild:web": "npm run patch:all",
    "build:web": "expo export --platform web"
  },
  "private": true
}
