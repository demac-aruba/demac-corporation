{
  "manifest_version": 3,
  "name": "DEMAC WhatsApp AI Copilot",
  "short_name": "DEMAC Copilot",
  "version": "0.2.2",
  "description": "Asistente privado de DEMAC para identificar solicitudes en el chat abierto, preparar respuestas e insertarlas o enviarlas con confirmación.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://us-central1-demac-corporation.cloudfunctions.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir DEMAC WhatsApp AI Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
