{
  "manifest_version": 3,
  "name": "DEMAC WhatsApp AI Copilot",
  "short_name": "DEMAC Copilot",
  "version": "0.1.0",
  "description": "Asistente privado de DEMAC para leer el chat abierto de WhatsApp Web, preparar borradores e insertarlos para revisión.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir DEMAC WhatsApp AI Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
