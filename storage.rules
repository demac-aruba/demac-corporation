rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function websiteAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner', 'super_admin'];
    }

    function validEvidenceImage() {
      return signedIn()
        && request.resource != null
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata != null
        && 'uploadedByUid' in request.resource.metadata
        && request.resource.metadata.uploadedByUid == request.auth.uid;
    }

    function validWebsiteImage() {
      return websiteAdmin()
        && request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function validWebsiteConfig() {
      return websiteAdmin()
        && request.resource != null
        && request.resource.size < 512 * 1024
        && request.resource.contentType == 'application/json';
    }

    function validEvidenceAudio() {
      return signedIn()
        && request.resource != null
        && request.resource.size < 6 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'video/mp4'
          || request.resource.contentType == 'application/octet-stream'
        )
        && request.resource.metadata != null
        && 'uploadedByUid' in request.resource.metadata
        && request.resource.metadata.uploadedByUid == request.auth.uid
        && 'mediaKind' in request.resource.metadata
        && request.resource.metadata.mediaKind == 'audio';
    }

    function uploadedByCurrentUser() {
      return signedIn()
        && resource != null
        && resource.metadata != null
        && 'uploadedByUid' in resource.metadata
        && resource.metadata.uploadedByUid == request.auth.uid;
    }

    function validCommunicationOutbound(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType.matches('application/.*')
        );
    }

    match /public-website/config/published.json {
      allow read: if true;
      allow create, update: if validWebsiteConfig();
      allow delete: if websiteAdmin();
    }

    match /public-website/{allPaths=**} {
      allow read: if true;
      allow create: if validWebsiteImage();
      allow update: if false;
      allow delete: if websiteAdmin();
    }

    match /work-orders/{workOrderId}/{unitId}/{fileName} {
      allow read: if signedIn();
      allow create: if validEvidenceImage() || validEvidenceAudio();
      allow update: if false;
      allow delete: if uploadedByCurrentUser();
    }

    match /inventory/{scope}/{entityId}/{fileName} {
      allow read: if signedIn();
      allow create: if validEvidenceImage();
      allow update: if false;
      allow delete: if uploadedByCurrentUser();
    }

    // Communication Center media stays private. Operators can upload only into
    // their own outbound prefix. Inbound media and profile-picture cache are
    // written by trusted backend code / signed Cloud Storage URLs.
    match /communication-media/outbound/{uid}/{conversationId}/{allPaths=**} {
      allow read: if signedIn();
      allow create: if validCommunicationOutbound(uid);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /communication-media/inbound/{conversationId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /communication-media/avatars/{identity}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
