# Copy to /etc/demac-whatsapp-bridge.env on the always-on Linux host.
# Keep the real file chmod 600 and never commit actual secrets.

PORT=8787
HOST=127.0.0.1
WACLI_BINARY=/usr/local/bin/wacli
WACLI_STORE_DIR=/var/lib/demac-wacli
BRIDGE_STATE_DIR=/var/lib/demac-whatsapp-bridge

# Generate independent random values, at least 32 bytes each.
BRIDGE_TOKEN=REPLACE_WITH_RANDOM_SECRET
WACLI_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# Firebase project is demac-corporation. Confirm the deployed function URL after deployment.
ERP_WEBHOOK_URL=https://us-central1-demac-corporation.cloudfunctions.net/wacliWebhook

# Optional tuning.
WACLI_SEND_TIMEOUT_MS=45000
WACLI_MEDIA_TIMEOUT_MS=45000
WACLI_MEDIA_MAX_BYTES=26214400
ERP_FORWARD_TIMEOUT_MS=15000
WEBHOOK_RETRY_INTERVAL_MS=5000
