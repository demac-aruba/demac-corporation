      { "id": "opt-2", "date": "2026-08-10", "time": "08:30" }
    ],
    "expected": { "intent": "select_option", "optionId": "opt-1", "mayCreateAppointment": true },
    "regression": "Colloquial 'a la 1' can identify the only offered afternoon option when the context makes the choice unique."
  },
  {
    "id": "bare-eight-selects-offered-eight-thirty",
    "customerMessage": "8",
    "options": [
      { "id": "opt-1", "date": "2026-08-18", "time": "08:30" },
      { "id": "opt-2", "date": "2026-08-18", "time": "09:30" }
    ],
    "expected": { "intent": "select_option", "optionId": "opt-1", "mayCreateAppointment": true },
    "regression": "A bare hour after offered options identifies the only option within that hour instead of becoming a new exact-time request."
  },
  {
    "id": "eight-am-selects-offered-eight-thirty",
    "customerMessage": "8 am",
    "options": [
      { "id": "opt-1", "date": "2026-08-18", "time": "08:30" },
      { "id": "opt-2", "date": "2026-08-18", "time": "09:30" }
    ],
    "expected": { "intent": "select_option", "optionId": "opt-1", "mayCreateAppointment": true },
    "regression": "Natural hour shorthand with am/pm may select the sole offered option in that hour."
  },
  {
    "id": "the-eight-one-selects-offered-eight-thirty",
    "customerMessage": "dame el de las 8",
    "options": [
      { "id": "opt-1", "date": "2026-08-18", "time": "08:30" },
      { "id": "opt-2", "date": "2026-08-18", "time": "09:30" }
