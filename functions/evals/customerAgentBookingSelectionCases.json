[
  {
    "id": "unique-monday-afternoon-selection",
    "customerMessage": "on lunes en la tarde esta bien",
    "options": [
      { "id": "opt-1", "date": "2026-08-10", "time": "13:30" },
      { "id": "opt-2", "date": "2026-08-11", "time": "13:30" }
    ],
    "expected": { "intent": "select_option", "optionId": "opt-1", "mayCreateAppointment": true },
    "regression": "A uniquely identified offered Monday-afternoon option may be selected."
  },
  {
    "id": "colloquial-one-means-offered-afternoon-slot",
